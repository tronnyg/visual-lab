{
    "name": "visual-lab",
    "version": "0.1.0",
    "private": true,
    "description": "Standalone visual component lab with OpenUI and MCP",
    "scripts": {
        "gen:library": "tsx scripts/gen-library.tsx",
        "dev": "npm run gen:library && next dev",
        "build": "npm run gen:library && next build",
        "start": "next start",
        "typecheck": "npm run gen:library && tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build:storybook": "storybook build",
        "test:storybook": "vitest run --project=storybook"
    },
    "dependencies": {
        "@floating-ui/react-dom": "^2.1.9",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@openuidev/lang-core": "~1.0.1",
        "@openuidev/react-lang": "~1.0.1",
        "@openuidev/react-ui": "~0.18.1",
        "lucide-react": "^0.575.0",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-is": "^19.3.1",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/addon-vitest": "^10.6.5",
        "@storybook/react-vite": "^10.6.5",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/browser-playwright": "^5.0.5",
        "playwright": "^1.64.1",
        "storybook": "^10.6.5",
        "tsx": "^4.19.2",
        "typescript": "^5.9.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=20"
    },
    "allowScripts": {
        "@openuidev/lang-core@1.0.2": true,
        "esbuild@0.28.2": true
    }
}
